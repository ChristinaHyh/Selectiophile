{
	"schemaVersion": "0.1.0",
	"name": "papers-SCID",
	"behavior": "create",
	"noteContentFormat": "{{selectorHtml:#abstracts|remove_html:(\".download-link\")|markdown}}\n\n{{selectorHtml:#body|remove_html:(\".download-link\")|markdown}}\n\n## References\n{{selectorHtml:.bibliography|remove_html:(\".ReferenceLinks,.section-title,svg\")|markdown}}",
	"properties": [
		{
			"name": "title",
			"value": "{{selector:#author-group .surname|first}}({{meta:name:citation_publication_date|slice:0,4}})-{{meta:name:citation_title|split:\" \"|slice:0,3|join:\" \"}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "doi",
			"value": "{{meta:name:citation_doi}}",
			"type": "text"
		},
		{
			"name": "paper_id",
			"value": "{{meta:name:citation_doi|replace:\"/[^0-9]/g\":\"\"|slice:-10}}",
			"type": "text"
		},
		{
			"name": "authors",
			"value": "{{selector:#author-group .react-xocs-alternative-link|unique|wikilink}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{meta:name:citation_publication_date|date:\"YYYY-MM-DD\"}}",
			"type": "date"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "journal",
			"value": "{{meta:name:citation_journal_title}}",
			"type": "text"
		},
		{
			"name": "collection",
			"value": "papers",
			"type": "text"
		},
		{
			"name": "keywords",
			"value": "{{selector:#keys0001 .keyword span|unique}}",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.sciencedirect.com/science/article/"
	],
	"noteNameFormat": "{{title|safe_name}}",
	"path": "references/papers"
}
